{
  "name": "bclouder-desafio-tecnico-countries-explorer",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.7.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node tools/generate-environment.js && ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generate-env": "node tools/generate-environment.js"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/animations": "21.2.4",
    "@angular/cdk": "21.2.4",
    "@angular/common": "21.2.19",
    "@angular/compiler": "21.2.19",
    "@angular/core": "21.2.17",
    "@angular/forms": "21.2.4",
    "@angular/material": "21.2.4",
    "@angular/platform-browser": "21.2.4",
    "@angular/platform-browser-dynamic": "21.2.4",
    "@angular/router": "21.2.4",
    "ngx-toastr": "^20.0.0",
    "rxjs": "7.8.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.20",
    "@angular/build": "21.2.20",
    "@angular/cli": "21.2.6",
    "@angular/compiler-cli": "21.2.4",
    "@types/jasmine": "^6.0.0",
    "jasmine-core": "^6.2.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "ngx-toastr": {
      "rxjs": "^7.4.0"
    }
  }
}
